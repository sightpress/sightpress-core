includes:
    - vendor/sightpress/plugin-core/quality/phpstan-base.neon

parameters:
    paths:
        - src
        - config
        - tests
        - bin
        - quality/src
    level: max
    tmpDir: var/phpstan
    excludePaths:
        # Code the custom rules must flag, read only by their tests.
        - tests/Quality/Fixtures
        # Generated by Symfony on every container build (config shapes for apps).
        - tests/Fixtures/App/config/reference.php

rules:
    # CLAUDE.md rule 6: SiteFilter is turned off only in super-admin code paths.
    - SightPress\Core\Quality\PHPStan\SiteFilterRule
