{#- The GOV.UK error-summary pattern: first in main, takes focus on load (autofocus works without
    JavaScript), and links to each field. `errors` is a list of {field: id, message: text}, already
    translated. Each field shows the same message inline, tied with aria-describedby. -#}
{%- if errors is not empty -%}
<div class="sp-error-summary" tabindex="-1" autofocus aria-labelledby="error-summary-title">
    <h2 id="error-summary-title">{{ 'admin.error_summary.title'|trans }}</h2>
    <p>{{ 'admin.error_summary.count'|trans({count: errors|length}) }}</p>
    <ul>
        {%- for error in errors %}
        <li><a href="#{{ error.field }}">{{ error.message }}</a></li>
        {%- endfor %}
    </ul>
</div>
{%- endif -%}
